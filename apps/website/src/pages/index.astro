---
/**
 * Homepage v2 — Grundgerüst-Neuaufbau. Siehe:
 * - docs/migration/current-homepage-inventory.md (Bestand + Kategorisierung)
 * - docs/migration/homepage-optimization-matrix.md (was wurde direkt verbessert)
 * - docs/migration/homepage-parity-and-improvement-report.md (Alt-Neu-Vergleich)
 *
 * Noch keine Live-Seite: noindex, sichtbar als interne Vorschau gekennzeichnet.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroSection from "@/components/sections/HeroSection.astro";
import TrustBar from "@/components/sections/TrustBar.astro";
import ServiceOverview from "@/components/sections/ServiceOverview.astro";
import ProcessSteps from "@/components/sections/ProcessSteps.astro";
import RightsAfterAccident from "@/components/sections/RightsAfterAccident.astro";
import DamageExamples from "@/components/sections/DamageExamples.astro";
import ReviewSection from "@/components/sections/ReviewSection.astro";
import LocationSection from "@/components/sections/LocationSection.astro";
import FaqSection from "@/components/sections/FaqSection.astro";
import FinalCtaSection from "@/components/sections/FinalCtaSection.astro";
import { site } from "@/data/site";
---

<BaseLayout
  title={site.seoDefaults.title}
  description={site.seoDefaults.description}
  noindex={true}
>
  <p class="preview-banner">
    Interne Website-V2-Vorschau – nicht für den Livebetrieb
  </p>

  <HeroSection />
  <TrustBar />
  <ServiceOverview />
  <ProcessSteps />
  <RightsAfterAccident />
  <DamageExamples />
  <ReviewSection />
  <LocationSection />
  <FaqSection />
  <FinalCtaSection />
</BaseLayout>

<style>
  .preview-banner {
    background: var(--color-navy);
    color: var(--color-white);
    text-align: center;
    padding: var(--space-2) var(--space-4);
    font-weight: var(--font-weight-bold);
    margin: 0;
  }
</style>
