---
/**
 * FAQ als natives <details>/<summary> — vollständig zugänglich und
 * bedienbar ohne jegliches JavaScript. Ohne Props identisch zum
 * bisherigen Verhalten (Homepage-FAQ aus homepage.ts). Mit Props
 * wiederverwendbar für Unterseiten mit eigener FAQ (z. B.
 * /leistungen/unfallgutachten-hamburg) — inklusive passendem
 * FAQPage-Schema für genau die auf der jeweiligen Seite sichtbaren
 * Fragen (ein FAQPage-Schema pro Seite, keine sitebreite Dopplung).
 */
import Section from "@/components/layout/Section.astro";
import { homepage } from "@/data/homepage";

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  heading?: string;
  intro?: string;
  items?: readonly FaqItem[];
  /** eindeutige Section-ID, falls mehrere FAQ-Sektionen im selben Dokument denkbar wären */
  id?: string;
}

const {
  heading = "Häufige Fragen",
  intro = homepage.faq.intro,
  items = homepage.faq.items,
  id = "faq",
} = Astro.props;

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<Section id={id} background="page" narrow>
  <h2>{heading}</h2>
  <p class="lede">{intro}</p>

  <div class="faq-list">
    {
      items.map((item) => (
        <details class="faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))
    }
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline />
</Section>

<style>
  .faq-list {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-3);
  }

  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-brand);
  }

  .faq-item p {
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
  }
</style>
