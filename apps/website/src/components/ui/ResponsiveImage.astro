---
/**
 * Wrapper um astro:assets Image mit sinnvollen Defaults gegen Layout Shift
 * und für Performance. `alt` ist Pflicht (keine dekorativen Bilder ohne
 * explizite Kennzeichnung).
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  width: number;
  height: number;
  /** true nur für das größte, sofort sichtbare Bild (z. B. Hero) */
  priority?: boolean;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  priority = false,
  class: className = "",
} = Astro.props;
---

<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  loading={priority ? "eager" : "lazy"}
  fetchpriority={priority ? "high" : "auto"}
  decoding={priority ? "sync" : "async"}
  class={className}
/>
