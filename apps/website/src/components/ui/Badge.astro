---
/**
 * Generisches Pill-Label. Basis für TrustBadge/QualificationBadge, aber
 * auch direkt einsetzbar für neutrale Kennzeichnungen.
 */
interface Props {
  tone?: "neutral" | "accent" | "inverse";
  class?: string;
}

const { tone = "neutral", class: className = "" } = Astro.props;
---

<span class:list={["badge", `badge--${tone}`, className]}>
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    line-height: 1;
  }

  .badge--neutral {
    background: var(--color-bg-surface);
    color: var(--color-text-primary);
  }

  .badge--accent {
    background: var(--color-teal-tint);
    color: var(--color-teal-hover);
  }

  .badge--inverse {
    background: rgba(255, 255, 255, 0.12);
    color: var(--color-text-inverse);
  }
</style>
