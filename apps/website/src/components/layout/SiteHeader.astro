---
import Container from "@/components/layout/Container.astro";
import Logo from "@/components/ui/Logo.astro";
import MobileNavigation from "@/components/navigation/MobileNavigation.astro";
import PrimaryCtaGroup from "@/components/conversion/PrimaryCtaGroup.astro";
import { site } from "@/data/site";
---

<header class="site-header">
  <Container class="site-header__inner">
    <a href="/" class="site-header__brand" aria-label={site.brandName}>
      <Logo variant="header" />
    </a>
    <div class="site-header__actions">
      <PrimaryCtaGroup size="md" class="site-header__cta" />
      <MobileNavigation />
    </div>
  </Container>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-page);
  }

  .site-header :global(.site-header__inner) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .site-header__brand {
    display: inline-flex;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .site-header :global(.site-header__cta) {
    display: none;
  }

  @media (min-width: 768px) {
    .site-header :global(.site-header__cta) {
      display: flex;
    }
  }
</style>
