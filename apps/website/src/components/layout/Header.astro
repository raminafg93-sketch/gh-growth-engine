---
import { Image } from "astro:assets";
import { site } from "@/data/site";
import WhatsAppCta from "@/components/conversion/WhatsAppCta.astro";
import logo from "@/assets/logo/gh-logo-header.png";
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand">
      <Image src={logo} alt={site.brandName} height={32} width={169} />
    </a>
    <nav class="site-header__nav" aria-label="Hauptnavigation">
      <a href={site.phone.href}>{site.phone.display}</a>
    </nav>
    <WhatsAppCta />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-grey-light);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .site-header__brand {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--color-navy);
    text-decoration: none;
  }

  .site-header__nav a {
    color: var(--color-anthracite);
    text-decoration: none;
    font-weight: 600;
  }
</style>
