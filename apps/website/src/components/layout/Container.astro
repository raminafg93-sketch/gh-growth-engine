---
/**
 * Zentrales Breiten- und Padding-Primitiv. Jede Section-/Seiteninhalt
 * verwendet dieses Element statt eigener Container-Logik (siehe
 * docs/architecture/design-system.md, Regel 3).
 */
interface Props {
  /** schmalere Breite für textlastige Inhalte (z. B. FAQ) */
  narrow?: boolean;
  class?: string;
}

const { narrow = false, class: className = "" } = Astro.props;
---

<div class:list={["container", narrow && "container--narrow", className]}>
  <slot />
</div>
