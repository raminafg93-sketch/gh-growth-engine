---
import Container from "@/components/layout/Container.astro";
import Logo from "@/components/ui/Logo.astro";
import { site } from "@/data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <Container class="site-footer__inner">
    <div class="site-footer__brand">
      <Logo variant="header" />
    </div>
    <address class="site-footer__contact">
      <p>{site.companyName} &middot; {site.address.official}</p>
      <p>
        <a href={site.phone.href}>{site.phone.display}</a> &middot;
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <p>{site.hours}{site.service247 ? " · 24/7-Service" : ""}</p>
    </address>
    <nav class="site-footer__legal-nav" aria-label="Rechtliches">
      <a href={`${site.websiteUrl}/impressum`}>Impressum</a>
    </nav>
    <p class="site-footer__note">
      Diese Seite ist ein internes Grundgerüst. Rechtsverbindliche Angaben
      findest Du auf der aktuellen Live-Website.
    </p>
    <p class="site-footer__copyright">&copy; {year} {site.companyName}</p>
  </Container>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-16);
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-surface);
    color: var(--color-text-primary);
    font-size: var(--text-sm);
  }

  .site-footer :global(.site-footer__inner) {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-10);
  }

  .site-footer__contact p {
    margin: 0 0 var(--space-2);
  }

  .site-footer__contact p:last-child {
    margin-bottom: 0;
  }

  .site-footer__legal-nav a {
    color: var(--color-text-primary);
    font-weight: var(--font-weight-medium);
  }

  .site-footer__copyright {
    opacity: 0.7;
    margin: 0;
  }
</style>
