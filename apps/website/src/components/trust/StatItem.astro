---
/**
 * Einzelne Kennzahl für TrustBar. Werte kommen ausschließlich aus
 * bestätigten Claims (02_COMPANY/02_trust-and-proof.md,
 * 11_OPERATIONS/02_proof-register.md) — hier nur Darstellung, keine neuen Zahlen.
 */
interface Props {
  value: string;
  label: string;
  class?: string;
}

const { value, label, class: className = "" } = Astro.props;
---

<div class:list={["stat-item", className]}>
  <span class="stat-item__value">{value}</span>
  <span class="stat-item__label">{label}</span>
</div>

<style>
  .stat-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .stat-item__value {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-3xl);
    color: var(--color-text-brand);
  }

  :global(.section--inverse) .stat-item__value {
    color: var(--color-text-inverse);
  }

  .stat-item__label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  :global(.section--inverse) .stat-item__label {
    color: rgba(255, 255, 255, 0.75);
  }
</style>
