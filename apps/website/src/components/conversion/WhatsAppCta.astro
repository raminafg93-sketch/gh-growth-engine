---
/**
 * Primärer Conversion-CTA nach 05_WEBSITE_SEO/03_conversion-system.md:
 * WhatsApp vor Anruf vor E-Mail vor Formular.
 *
 * Fällt automatisch auf den Anruf-CTA zurück, solange keine bestätigte
 * WhatsApp-Nummer in site.ts hinterlegt ist (site.whatsapp.status === "missing").
 */
import { site, isConfirmed } from "@/data/site";

interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
const whatsapp = site.whatsapp;
---

{
  isConfirmed(whatsapp) ? (
    <a
      class:list={["cta", "cta--primary", className]}
      href={whatsapp.value.href}
    >
      {site.cta.primary}
    </a>
  ) : (
    <a class:list={["cta", "cta--primary", className]} href={site.phone.href}>
      {site.cta.secondary}
    </a>
  )
}

<style>
  .cta {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    text-decoration: none;
  }

  .cta--primary {
    background: var(--color-teal);
    color: var(--color-white);
  }
</style>
