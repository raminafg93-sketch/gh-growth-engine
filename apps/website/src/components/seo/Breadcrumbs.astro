---
/**
 * Breadcrumb-Navigation + BreadcrumbList-Schema. Auf der Homepage selbst
 * nicht sinnvoll (kein Pfad oberhalb von "/") — vorbereitet für künftige
 * Unterseiten (/leistungen/…, /ratgeber/…), siehe
 * docs/architecture/homepage-seo-specification.md.
 */
import { site } from "@/data/site";

interface Crumb {
  label: string;
  href: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    // item.href ist meist ein relativer Pfad dieser Seite; einzelne Krumen
    // (z. B. "Leistungen") zeigen bewusst auf die externe Live-Website
    // (siehe ServiceOverview.astro, "kein toter interner Link") und liefern
    // bereits eine vollständige URL — dann nicht zusätzlich site.websiteUrl voranstellen.
    item: item.href.startsWith("http")
      ? item.href
      : `${site.websiteUrl}${item.href}`,
  })),
};
---

{
  items.length > 1 && (
    <nav aria-label="Breadcrumb" class="breadcrumbs">
      <ol>
        {items.map((item, index) => (
          <li>
            {index === items.length - 1 ? (
              <span aria-current="page">{item.label}</span>
            ) : (
              <a href={item.href}>{item.label}</a>
            )}
          </li>
        ))}
      </ol>
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
        is:inline
      />
    </nav>
  )
}

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .breadcrumbs li:not(:last-child)::after {
    content: "/";
    margin-left: var(--space-2);
  }
</style>
