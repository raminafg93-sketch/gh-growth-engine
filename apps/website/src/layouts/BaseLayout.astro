---
import SeoHead from "@/components/seo/SeoHead.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import StickyMobileCta from "@/components/conversion/StickyMobileCta.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={title} description={description} noindex={noindex} />
    <JsonLd />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Zum Inhalt springen</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <StickyMobileCta />
  </body>
</html>

<style>
  main {
    display: block;
    /* Platz für die mobile Sticky-CTA, damit sie den letzten Inhalt nicht verdeckt */
    padding-bottom: calc(var(--button-height-md) + var(--space-6));
  }

  @media (min-width: 768px) {
    main {
      padding-bottom: 0;
    }
  }
</style>
